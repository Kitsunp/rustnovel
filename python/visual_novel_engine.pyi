class AudioController:
    def play_bgm(
        self,
        asset: str,
        loop: bool = ...,
        fade_in: float = ...,
        volume: Optional[float] = ...,
    ) -> None: ...
    def stop_all(self, fade_out: float = ...) -> None: ...
    def play_sfx(self, asset: str, volume: Optional[float] = ...) -> None: ...
    def play_voice(self, asset: str, volume: Optional[float] = ...) -> None: ...

class Engine:
    def __init__(self, script_json: str) -> None: ...
    def current_event(self) -> Dict[str, Any]: ...
    def current_event_json(self) -> str: ...
    def visual_state(self) -> Dict[str, Any]: ...
    def ui_state(self) -> Dict[str, Any]: ...
    def step(self) -> StepResult: ...
    def choose(self, option_index: int) -> Dict[str, Any]: ...
    def resume(self) -> None: ...
    def supported_event_types(self) -> List[str]: ...
    def set_resources(self, config: ResourceConfig) -> None: ...
    def get_memory_usage(self) -> Dict[str, Any]: ...
    def cache_asset(self, asset_path: str, data: bytes) -> None: ...
    def get_cached_asset(self, asset_path: str) -> Optional[bytes]: ...
    def invalidate_cached_asset(self, asset_path: str) -> bool: ...
    def clear_asset_cache(self) -> None: ...
    def evict_unused_assets(self) -> int: ...
    def asset_cache_stats(self) -> Dict[str, Any]: ...
