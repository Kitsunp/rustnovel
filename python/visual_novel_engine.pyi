class VnError(Exception): ...
class VnValidationError(VnError): ...
class VnSecurityPolicyError(VnError): ...
class VnResourceLimitError(VnError): ...
class VnEndOfScriptError(VnError): ...

class StepResult:
    event: Dict[str, Any]
    audio: List[Dict[str, Any]]

class ResourceConfig:
    def __init__(
        self, max_texture_memory: int = ..., max_script_bytes: int = ...
