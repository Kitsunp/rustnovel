class PyEngine(Engine): ...

class StoryNode:
    @classmethod
    def start(cls) -> "StoryNode": ...
    @classmethod
    def end(cls) -> "StoryNode": ...
    @classmethod
    def dialogue(cls, speaker: str, text: str) -> "StoryNode": ...
    @classmethod
    def scene(
        cls,
        background: Optional[str] = ...,
        music: Optional[str] = ...,
        characters: Sequence[Any] = ...,
    ) -> "StoryNode": ...
    @classmethod
    def scene_full(
        cls,
        background: Optional[str] = ...,
        music: Optional[str] = ...,
        characters: Sequence[Any] = ...,
    ) -> "StoryNode": ...
    @classmethod
    def choice(cls, prompt: str, options: Sequence[str]) -> "StoryNode": ...
    @classmethod
    def set_flag(cls, key: str, value: bool) -> "StoryNode": ...
    @classmethod
    def set_variable(cls, key: str, value: int) -> "StoryNode": ...
    @classmethod
    def jump(cls, target: str) -> "StoryNode": ...
    @classmethod
    def jump_if_flag(cls, key: str, is_set: bool, target: str) -> "StoryNode": ...
    @classmethod
    def jump_if_var(cls, key: str, op: str, value: int, target: str) -> "StoryNode": ...
    @classmethod
    def scene_patch(
        cls,
        background: Optional[str] = ...,
        music: Optional[str] = ...,
        add: Sequence[Any] = ...,
        update: Sequence[Any] = ...,
        remove: Sequence[str] = ...,
    ) -> "StoryNode": ...
    @classmethod
    def scene_patch_full(
        cls,
        background: Optional[str] = ...,
        music: Optional[str] = ...,
        add: Sequence[Any] = ...,
        update: Sequence[Any] = ...,
        remove: Sequence[str] = ...,
    ) -> "StoryNode": ...
    @classmethod
    def audio_action(
        cls,
        channel: str,
        action: str,
        asset: Optional[str] = ...,
        volume: Optional[float] = ...,
        fade_duration_ms: Optional[int] = ...,
        loop_playback: Optional[bool] = ...,
    ) -> "StoryNode": ...
    @classmethod
    def transition(
        cls, kind: str, duration_ms: int, color: Optional[str] = ...
    ) -> "StoryNode": ...
    @classmethod
    def character_placement(
        cls, name: str, x: int, y: int, scale: Optional[float] = ...
    ) -> "StoryNode": ...
    @classmethod
    def subgraph_call(
        cls,
        fragment_id: str,
        entry_port: Optional[str] = ...,
        exit_port: Optional[str] = ...,
    ) -> "StoryNode": ...
    @classmethod
    def generic(cls, event_json: str) -> "StoryNode": ...
    @classmethod
    def ext_call(cls, command: str, args: Sequence[str] = ...) -> "StoryNode": ...

class NodeGraph:
    def __init__(self) -> None: ...
